{
  "version": 4,
  "remoteUpdateUrl": "https://raw.githubusercontent.com/ferdausfs/Mobile-Harness/main/app/src/main/assets/zweb/selectors.json",
  "page": {
    "startUrl": "https://chat.z.ai/",
    "authProbePath": "/api/v1/auths/"
  },
  "selectors": {
    "input": [
      "#chat-input",
      "textarea[placeholder='Send a Message']",
      "main textarea",
      "textarea"
    ],
    "sendButton": [
      "#send-message-button",
      "button.sendMessageButton",
      "form button[type='submit']"
    ],
    "stopIndicator": [
      "div[aria-label='Stop']",
      "[aria-label='Stop']"
    ],
    "assistantMessage": [
      ".chat-assistant",
      ".markdown-prose.chat-assistant",
      "[class*='chat-assistant']"
    ],
    "userMessage": [
      ".chat-user",
      ".markdown-prose.chat-user",
      "[class*='chat-user']"
    ],
    "codeBlock": [
      ".chat-assistant pre code",
      ".markdown-prose pre code",
      "pre code"
    ],
    "fileCard": [
      "[class*='file-card']",
      "[class*='fileCard']",
      "a[href*='/api/v1/files/']"
    ],
    "loginMarker": [
      "url-contains:/auth",
      "text:=Welcome to Z.ai",
      "text:=Continue with Email"
    ],
    "loginFormMarker": [
      "text:=Welcome to Z.ai",
      "text:=Continue with Email",
      "text:=Continue with Google"
    ],
    "sidebarToggle": [
      "#sidebar-toggle-button",
      "button[aria-label='Toggle Sidebar']",
      "[id*='sidebar-toggle']",
      "button[aria-label*='sidebar' i]"
    ],
    "signInButton": [
      "text-button:=sign in",
      "text-button:=log in",
      "button[aria-label='Sign in']",
      "a[href='/auth']",
      "a[href*='/auth']"
    ],
    "captchaMarker": [
      "#aliyunCaptcha-window-popup.window-show",
      "[id^='aliyunCaptcha-window']",
      ".aliyunCaptcha-sliding-text"
    ],
    "newChatButton": [
      "#new-chat-button",
      "[aria-label='New Chat']",
      "a[aria-label='New Chat']"
    ],
    "thinkingBlock": [
      ".chat-assistant details[type='reasoning']",
      ".chat-assistant details",
      "details[type='reasoning']",
      ".thinking-block",
      "[class*='thinking-block']"
    ],
    "partialAnswer": [
      ".chat-assistant",
      ".markdown-prose.chat-assistant",
      "[class*='chat-assistant']"
    ],
    "stepStatus": [
      ".chat-assistant .shimmer",
      "span.shimmer",
      ".shimmer",
      ".chat-assistant [class*='text-text-tertiary']",
      ".chat-assistant div[class*='gap-2'][class*='items-center'] span.text-sm"
    ],
    "modelLabel": [
      "button.modelSelectorButton",
      "button[aria-label='Select a model']",
      "[id^='model-selector-'][id$='-button']"
    ],
    "modelMenuButton": [
      "button.modelSelectorButton",
      "button[aria-label='Select a model']",
      "[id^='model-selector-'][id$='-button']"
    ],
    "modelOption": [
      ".popoverContainer div[class*='line-clamp-1'][class*='select-none']",
      ".popoverContainer [class*='select-none'][class*='p-2']",
      "[data-dropdown-select-content] [role='option']",
      "[data-bits-select-content] [role='option']",
      "[class*='selectContent'] [role='option']"
    ],
    "thinkMenuButton": [
      "text-button:=deep think",
      "text-button:=thinking",
      "button[aria-label*='deep think' i]",
      "[aria-label*='deep think' i]",
      "button[aria-label*='think' i]"
    ],
    "thinkMenuContent": [
      "[data-dropdown-menu-content]",
      "[data-bits-menu-content]",
      "[role='menu']",
      "[class*='menuContent' i]"
    ],
    "thinkMenuItem": [
      "[data-dropdown-menu-content] [role='menuitem'], [data-dropdown-menu-content] [role='menuitemcheckbox'], [data-dropdown-menu-content] [role='menuitemradio']",
      "[role='menu'] [role='menuitem'], [role='menu'] [role='menuitemcheckbox'], [role='menu'] [role='menuitemradio']",
      "[data-dropdown-menu-content] > *",
      "[role='menu'] > *"
    ]
  },
  "timing": {
    "pageLoadTimeoutMs": 25000,
    "pageSettleMs": 1500,
    "sendSettleMs": 2500,
    "pollIntervalMs": 900,
    "stableWindowMs": 4000,
    "generationTimeoutMs": 300000
  }
}
